{
  "name": "CC Mode Switcher",
  "short_name": "CC Mode",
  "description": "Multi-role switcher for Claude Code — any number of roles, isolated sessions, no-touch on ~/.claude/settings.json or ~/.zshrc",
  "start_url": "/cc-mode-switcher/",
  "scope": "/cc-mode-switcher/",
  "display": "standalone",
  "background_color": "#0E1B1A",
  "theme_color": "#2DBA68",
  "icons": [
    { "src": "/cc-mode-switcher/favicon-16x16.png", "sizes": "16x16", "type": "image/png" },
    { "src": "/cc-mode-switcher/favicon-32x32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "/cc-mode-switcher/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/cc-mode-switcher/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/cc-mode-switcher/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" }
  ]
}